<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Downloads — SocialDL</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --bg: #0a0a0f;
      --surface: #12121a;
      --surface2: #1a1a26;
      --border: #2a2a3d;
      --accent: #6c63ff;
      --accent2: #ff6584;
      --text: #e8e8f0;
      --muted: #6b7280;
      --success: #10b981;
      --warning: #f59e0b;
      --error: #ef4444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Syne', sans-serif;
      min-height: 100vh;
    }

    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 2rem;
      border-bottom: 1px solid var(--border);
      background: rgba(10, 10, 15, .9);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--text);
      text-decoration: none;
      letter-spacing: -1px;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }

    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: .85rem;
      font-weight: 600;
      transition: color .2s;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-links .active {
      color: var(--accent);
    }

    .nav-links .nav-cta {
      background: var(--accent);
      color: #fff;
      padding: .4rem .9rem;
      border-radius: 6px;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 2.5rem 2rem;
    }

    .page-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      flex-wrap: gap;
      gap: 1rem;
    }

    .page-head h1 {
      font-size: 1.6rem;
      font-weight: 800;
    }

    .page-head p {
      color: var(--muted);
      font-size: .85rem;
      margin-top: .2rem;
    }

    .new-btn {
      background: linear-gradient(135deg, var(--accent), #8b5cf6);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: .75rem 1.4rem;
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: .85rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: .4rem;
    }

    /* Stats row */
    .stats-row {
      display: flex;
      gap: 1rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem 1.4rem;
      flex: 1;
      min-width: 140px;
    }

    .stat-label {
      font-size: .72rem;
      color: var(--muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 800;
      margin-top: .2rem;
    }

    /* Empty state */
    .empty {
      text-align: center;
      padding: 5rem 2rem;
    }

    .empty-icon {
      font-size: 3.5rem;
      margin-bottom: 1rem;
    }

    .empty h2 {
      font-size: 1.3rem;
      margin-bottom: .5rem;
    }

    .empty p {
      color: var(--muted);
      margin-bottom: 1.5rem;
    }

    /* Files grid */
    .files-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem;
    }

    .file-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      transition: border-color .15s;
    }

    .file-card:hover {
      border-color: rgba(108, 99, 255, .4);
    }

    .file-preview {
      height: 160px;
      background: var(--surface2);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .file-preview video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .file-preview-icon {
      font-size: 3rem;
    }

    .file-preview-thumb {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .file-body {
      padding: 1rem;
    }

    .file-platform {
      display: inline-block;
      background: rgba(108, 99, 255, .1);
      color: var(--accent);
      padding: .15rem .5rem;
      border-radius: 999px;
      font-size: .68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      margin-bottom: .5rem;
    }

    .file-name {
      font-size: .85rem;
      font-weight: 600;
      line-height: 1.3;
      word-break: break-all;
      margin-bottom: .3rem;
      font-family: 'DM Mono', monospace;
    }

    .file-title {
      font-size: .8rem;
      color: var(--muted);
      margin-bottom: .5rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .file-meta {
      display: flex;
      gap: .5rem;
      flex-wrap: wrap;
      margin-bottom: .85rem;
    }

    .meta-tag {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: .15rem .5rem;
      font-size: .7rem;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
    }

    .file-actions {
      display: flex;
      gap: .5rem;
    }

    .action-btn {
      flex: 1;
      padding: .5rem;
      border-radius: 8px;
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: .75rem;
      cursor: pointer;
      border: none;
      text-decoration: none;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .3rem;
      transition: opacity .15s;
    }

    .action-btn:hover {
      opacity: .85;
    }

    .btn-stream {
      background: var(--accent);
      color: #fff;
    }

    .btn-dl {
      background: var(--surface2);
      border: 1px solid var(--border);
      color: var(--text);
    }

    .btn-del {
      background: rgba(239, 68, 68, .08);
      border: 1px solid rgba(239, 68, 68, .2);
      color: #fca5a5;
      width: 36px;
      flex: none;
    }

    /* Video modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .85);
      z-index: 999;
      align-items: center;
      justify-content: center;
    }

    .modal-overlay.show {
      display: flex;
    }

    .modal {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      max-width: 760px;
      width: 90vw;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .modal-title {
      font-size: 1rem;
      font-weight: 700;
    }

    .modal-close {
      background: none;
      border: none;
      color: var(--muted);
      font-size: 1.3rem;
      cursor: pointer;
    }

    .modal video {
      width: 100%;
      border-radius: 10px;
      max-height: 60vh;
      background: #000;
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: .85rem 1.2rem;
      font-size: .85rem;
      z-index: 1000;
      transform: translateY(100px);
      opacity: 0;
      transition: all .3s;
    }

    .toast.show {
      transform: none;
      opacity: 1;
    }

    .toast.success {
      border-color: rgba(16, 185, 129, .3);
      color: #6ee7b7;
    }

    .toast.error {
      border-color: rgba(239, 68, 68, .3);
      color: #fca5a5;
    }

    footer {
      text-align: center;
      padding: 2rem;
      color: var(--muted);
      font-size: .8rem;
      border-top: 1px solid var(--border);
      margin-top: 3rem;
    }
  </style>
</head>

<body>

  <nav class="navbar">
    <a href="/" class="logo">Social<span>DL</span></a>
    <div class="nav-links">
      <a href="/downloader">⬇ Save to Server</a>
      <a href="/downloader/downloads" class="active">📂 My Downloads</a>
      <a href="/autolink">🔗 Get Links</a>

    </div>
  </nav>

  <div class="container">
    <div class="page-head">
      <div>
        <h1>📂 Downloads</h1>
        <p>All videos saved to your server</p>
      </div>
      <a href="/downloader" class="new-btn">⬇ Download New</a>
    </div>

    <!-- Stats -->
    <% const totalSize=files.reduce((s, f)=> s + f.rawSize, 0);
      const fmtTotal = totalSize > 1024*1024*1024 ? (totalSize/(1024*1024*1024)).toFixed(2)+' GB' : totalSize >
      1024*1024 ? (totalSize/(1024*1024)).toFixed(1)+' MB' : (totalSize/1024).toFixed(0)+' KB';
      %>
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-label">Total Files</div>
          <div class="stat-value">
            <%= files.length %>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Total Size</div>
          <div class="stat-value">
            <%= files.length ? fmtTotal : '—' %>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Platforms</div>
          <div class="stat-value">
            <%= [...new Set(files.map(f=> f.platform).filter(p => p !== '—'))].length %>
          </div>
        </div>
      </div>

      <% if (files.length===0) { %>
        <div class="empty">
          <div class="empty-icon">📭</div>
          <h2>No downloads yet</h2>
          <p>Paste a social media link to save your first video to the server.</p>
          <a href="/downloader" class="new-btn">⬇ Download a Video</a>
        </div>
        <% } else { %>
          <div class="files-grid">
            <% files.forEach(file=> {
              const isVideo = /\.(mp4|webm|mov|mkv)$/i.test(file.fileName);
              const isAudio = /\.(mp3|m4a)$/i.test(file.fileName);
              %>
              <div class="file-card" id="card-<%= file.fileName.replace(/[^a-z0-9]/gi,'_') %>">
                <div class="file-preview">
                  <% if (isVideo) { %>
                    <% if (file.thumb) { %>
                      <img class="file-preview-thumb" src="<%= file.thumb %>" alt=""
                        onerror="this.style.display='none'" />
                      <% } else { %>
                        <span class="file-preview-icon">🎬</span>
                        <% } %>
                          <% } else if (isAudio) { %>
                            <span class="file-preview-icon">🎵</span>
                            <% } else { %>
                              <span class="file-preview-icon">📄</span>
                              <% } %>
                </div>

                <div class="file-body">
                  <span class="file-platform">
                    <%= file.platform %>
                  </span>
                  <% if (file.title && file.title !==file.fileName) { %>
                    <div class="file-title">
                      <%= file.title %>
                    </div>
                    <% } %>
                      <div class="file-name">
                        <%= file.fileName %>
                      </div>
                      <div class="file-meta">
                        <span class="meta-tag">📦 <%= file.size %></span>
                        <span class="meta-tag">📅 <%= file.createdAt %></span>
                      </div>
                      <div class="file-actions">
                        <% if (isVideo) { %>
                          <button class="action-btn btn-stream"
                            onclick="openModal('/downloader/serve/<%= encodeURIComponent(file.fileName) %>', '<%= file.title || file.fileName %>')">▶
                            Stream</button>
                          <% } else { %>
                            <a class="action-btn btn-stream"
                              href="/downloader/serve/<%= encodeURIComponent(file.fileName) %>" target="_blank">▶
                              Play</a>
                            <% } %>
                              <a class="action-btn btn-dl"
                                href="/downloader/dl/<%= encodeURIComponent(file.fileName) %>">⬇ Download</a>
                              <button class="action-btn btn-del" onclick="deleteFile('<%= file.fileName %>')"
                                title="Delete">🗑</button>
                      </div>
                </div>
              </div>
              <% }) %>
          </div>
          <% } %>
  </div>

  <!-- Video Modal -->
  <div class="modal-overlay" id="videoModal">
    <div class="modal">
      <div class="modal-header">
        <span class="modal-title" id="modalTitle"></span>
        <video id="modalVideo" controls preload="auto"></video <button class="modal-close"
          onclick="closeModal()">✕</button>
      </div>
      <video id="modalVideo" controls preload="auto"></video>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <footer>SocialDL · Server Downloads · Powered by RapidAPI</footer>

  <script>
    function openModal(src, title) {
      const video = document.getElementById('modalVideo');

      video.pause();        // stop old video
      video.src = src;      // set new video
      video.load();         // 🔥 VERY IMPORTANT (main fix)

      video.play().catch(() => { }); // prevent autoplay error

      document.getElementById('modalTitle').textContent = title;
      document.getElementById('videoModal').classList.add('show');
    }

    function closeModal() {
      const v = document.getElementById('modalVideo');
      v.pause();
      v.src = '';
      document.getElementById('videoModal').classList.remove('show');
    }

    document.getElementById('videoModal').addEventListener('click', function (e) {
      if (e.target === this) closeModal();
    });

    async function deleteFile(fileName) {
      if (!confirm(`Delete "${fileName}" from server?`)) return;
      try {
        const res = await fetch(`/downloader/delete/${encodeURIComponent(fileName)}`, { method: 'DELETE' });
        const data = await res.json();
        document.getElementById("player").src =
          `/downloader/serve/${data.fileName}`;
        if (data.ok) {
          const card = document.getElementById('card-' + fileName.replace(/[^a-z0-9]/gi, '_'));
          if (card) { card.style.transition = 'opacity .3s, transform .3s'; card.style.opacity = '0'; card.style.transform = 'scale(.95)'; setTimeout(() => card.remove(), 300); }
          showToast('File deleted', 'success');
        } else {
          showToast(data.error || 'Delete failed', 'error');
        }
      } catch (e) {
        showToast('Error: ' + e.message, 'error');
      }
    }
    async function loadVideo() {
      const res = await fetch('/your-api'); // backend route
      const data = await res.json();

      const video = document.getElementById('player');

      video.src = data.videoUrl;   // 👈 THIS LINE IS KEY

      video.load();
      video.play();
    }
    function showToast(msg, type = 'success') {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = `toast ${type} show`;
      setTimeout(() => t.classList.remove('show'), 3000);
    }
  </script>
</body>

</html>