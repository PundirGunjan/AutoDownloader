<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Video Downloader — SocialDL</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css"/>
  <style>
    :root {
      --bg: #0a0a0f;
      --surface: #12121a;
      --surface2: #1a1a26;
      --border: #2a2a3d;
      --accent: #6c63ff;
      --accent2: #ff6584;
      --text: #e8e8f0;
      --muted: #6b7280;
      --success: #10b981;
      --warning: #f59e0b;
      --error: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: 'Syne', sans-serif; min-height: 100vh; }

    /* NAV */
    .navbar { display: flex; align-items: center; justify-content: space-between; padding: 1rem 2rem; border-bottom: 1px solid var(--border); background: rgba(10,10,15,.9); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 100; }
    .logo { font-size: 1.4rem; font-weight: 800; color: var(--text); text-decoration: none; letter-spacing: -1px; }
    .logo span { color: var(--accent); }
    .nav-links { display: flex; gap: 1.5rem; align-items: center; }
    .nav-links a { color: var(--muted); text-decoration: none; font-size: .85rem; font-weight: 600; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .nav-links .active { color: var(--accent); }
    .nav-links .nav-cta { background: var(--accent); color: #fff; padding: .4rem .9rem; border-radius: 6px; }

    /* HERO */
    .hero { text-align: center; padding: 5rem 2rem 3rem; position: relative; overflow: hidden; }
    .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(108,99,255,.15), transparent); pointer-events: none; }
    .hero-badge { display: inline-flex; align-items: center; gap: .5rem; background: rgba(108,99,255,.1); border: 1px solid rgba(108,99,255,.3); color: var(--accent); padding: .35rem .85rem; border-radius: 999px; font-size: .78rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; margin-bottom: 1.5rem; }
    .hero h1 { font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 800; line-height: 1.1; letter-spacing: -2px; margin-bottom: 1rem; }
    .hero h1 span { background: linear-gradient(135deg, var(--accent), var(--accent2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero p { color: var(--muted); font-size: 1.05rem; max-width: 520px; margin: 0 auto 2.5rem; line-height: 1.6; }

    /* MAIN FORM CARD */
    .form-card { max-width: 680px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 2rem; }
    .url-row { display: flex; gap: .75rem; }
    .url-input { flex: 1; background: var(--bg); border: 1.5px solid var(--border); border-radius: 10px; padding: .85rem 1.1rem; color: var(--text); font-family: 'DM Mono', monospace; font-size: .9rem; outline: none; transition: border-color .2s; }
    .url-input:focus { border-color: var(--accent); }
    .url-input::placeholder { color: var(--muted); }
    .fetch-btn { background: linear-gradient(135deg, var(--accent), #8b5cf6); color: #fff; border: none; border-radius: 10px; padding: .85rem 1.6rem; font-family: 'Syne', sans-serif; font-weight: 700; font-size: .9rem; cursor: pointer; white-space: nowrap; transition: opacity .2s, transform .1s; }
    .fetch-btn:hover { opacity: .9; }
    .fetch-btn:active { transform: scale(.98); }

    /* Platform chips */
    .platform-chips { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1rem; }
    .chip { background: var(--surface2); border: 1px solid var(--border); border-radius: 999px; padding: .3rem .75rem; font-size: .75rem; color: var(--muted); cursor: pointer; transition: all .15s; user-select: none; }
    .chip:hover { border-color: var(--accent); color: var(--accent); }

    /* Alert */
    .alert { display: flex; align-items: center; gap: .75rem; padding: 1rem 1.2rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: .9rem; }
    .alert-error { background: rgba(239,68,68,.08); border: 1px solid rgba(239,68,68,.3); color: #fca5a5; }

    /* Features grid */
    .features { max-width: 860px; margin: 3rem auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 0 2rem; }
    .feat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.4rem; }
    .feat-icon { font-size: 1.5rem; margin-bottom: .75rem; }
    .feat-card h3 { font-size: .95rem; font-weight: 700; margin-bottom: .3rem; }
    .feat-card p { font-size: .8rem; color: var(--muted); line-height: 1.5; }

    /* Supported platforms */
    .supported { text-align: center; padding: 2rem 2rem 4rem; }
    .supported h2 { font-size: 1.1rem; color: var(--muted); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 1.2rem; }
    .platform-list { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; }
    .plat { display: flex; flex-direction: column; align-items: center; gap: .4rem; color: var(--muted); font-size: .8rem; font-weight: 600; }
    .plat-icon { font-size: 2rem; }

    /* Download lib link */
    .lib-link { display: inline-flex; align-items: center; gap: .5rem; margin-top: 1rem; color: var(--accent); font-size: .85rem; text-decoration: none; font-weight: 600; }
    .lib-link:hover { text-decoration: underline; }

    footer { text-align: center; padding: 2rem; color: var(--muted); font-size: .8rem; border-top: 1px solid var(--border); }
  </style>
</head>
<body>

<nav class="navbar">
  <a href="/" class="logo">Social<span>DL</span></a>
  <div class="nav-links">
    <a href="/downloader" class="active">⬇ Save to Server</a>
    <a href="/downloader/downloads">📂 My Downloads</a>
    <a href="/autolink">🔗 Get Links</a>
  
  </div>
</nav>

<section class="hero">
  <div class="hero-badge">✦ Server-side downloader</div>
  <h1>Save Videos <span>Directly to<br/>Your Server</span></h1>
  <p>Paste any social media link — we'll fetch it, download it to the server, and let you stream or re-download it anytime.</p>
</section>

<div style="padding: 0 2rem 2rem; max-width: 680px; margin: 0 auto;">
  <% if (error) { %>
  <div class="alert alert-error"><span>⚠️</span> <%= error %></div>
  <% } %>

  <div class="form-card">
    <form action="/downloader/fetch" method="POST">
      <div class="url-row">
        <input class="url-input" type="url" name="url" placeholder="https://www.tiktok.com/@user/video/…" required autofocus />
        <button type="submit" class="fetch-btn">Fetch Links ↗</button>
      </div>
    </form>

    <div class="platform-chips" id="chips">
      <span class="chip" onclick="fillUrl('https://www.tiktok.com/@yeuphimzz/video/7237370304337628442')">🎵 TikTok example</span>
      <span class="chip" onclick="fillUrl('https://www.instagram.com/reel/C0example/')">📸 Instagram example</span>
      <span class="chip" onclick="fillUrl('https://twitter.com/user/status/123456789')">🐦 Twitter example</span>
      <span class="chip" onclick="fillUrl('https://www.youtube.com/shorts/abc123')">▶️ YouTube Shorts</span>
    </div>

    <a href="/downloader/downloads" class="lib-link">📂 View saved downloads →</a>
  </div>
</div>

<div class="features">
  <div class="feat-card">
    <div class="feat-icon">⚡</div>
    <h3>Real-time Progress</h3>
    <p>Watch live download progress with byte-level tracking via Server-Sent Events.</p>
  </div>
  <div class="feat-card">
    <div class="feat-icon">🎛️</div>
    <h3>Quality Selection</h3>
    <p>Choose from all available qualities returned by the API before saving.</p>
  </div>
  <div class="feat-card">
    <div class="feat-icon">▶️</div>
    <h3>Stream or Download</h3>
    <p>Saved files can be streamed in browser or downloaded to your local machine.</p>
  </div>
  <div class="feat-card">
    <div class="feat-icon">🗑️</div>
    <h3>File Manager</h3>
    <p>Browse, preview, and delete all saved files from one clean dashboard.</p>
  </div>
</div>

<div class="supported">
  <h2>Supported Platforms</h2>
  <div class="platform-list">
    <div class="plat"><span class="plat-icon">🎵</span>TikTok</div>
    <div class="plat"><span class="plat-icon">📸</span>Instagram</div>
    <div class="plat"><span class="plat-icon">▶️</span>YouTube</div>
    <div class="plat"><span class="plat-icon">🐦</span>Twitter/X</div>
    <div class="plat"><span class="plat-icon">📘</span>Facebook</div>
  </div>
</div>

<footer>SocialDL · Powered by RapidAPI · Node.js</footer>

<script>
  function fillUrl(url) {
    document.querySelector('.url-input').value = url;
  }
</script>
</body>
</html>
