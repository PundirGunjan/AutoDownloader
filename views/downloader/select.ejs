<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Select Quality — SocialDL</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0a0a0f; --surface: #12121a; --surface2: #1a1a26;
      --border: #2a2a3d; --accent: #6c63ff; --accent2: #ff6584;
      --text: #e8e8f0; --muted: #6b7280; --success: #10b981;
      --warning: #f59e0b; --error: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: 'Syne', sans-serif; min-height: 100vh; }

    .navbar { display: flex; align-items: center; justify-content: space-between; padding: 1rem 2rem; border-bottom: 1px solid var(--border); background: rgba(10,10,15,.9); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 100; }
    .logo { font-size: 1.4rem; font-weight: 800; color: var(--text); text-decoration: none; letter-spacing: -1px; }
    .logo span { color: var(--accent); }
    .nav-links { display: flex; gap: 1.5rem; align-items: center; }
    .nav-links a { color: var(--muted); text-decoration: none; font-size: .85rem; font-weight: 600; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .nav-links .nav-cta { background: var(--accent); color: #fff; padding: .4rem .9rem; border-radius: 6px; }

    .container { max-width: 820px; margin: 0 auto; padding: 2.5rem 2rem; }

    /* Back */
    .back-link { display: inline-flex; align-items: center; gap: .4rem; color: var(--muted); text-decoration: none; font-size: .85rem; margin-bottom: 2rem; transition: color .2s; }
    .back-link:hover { color: var(--text); }

    /* Media info card */
    .media-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; display: flex; gap: 1.5rem; margin-bottom: 2rem; align-items: flex-start; }
    .media-thumb { width: 140px; height: 100px; object-fit: cover; border-radius: 10px; flex-shrink: 0; background: var(--surface2); }
    .media-thumb-placeholder { width: 140px; height: 100px; border-radius: 10px; background: var(--surface2); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; flex-shrink: 0; }
    .media-info { flex: 1; min-width: 0; }
    .media-platform { display: inline-block; background: rgba(108,99,255,.1); border: 1px solid rgba(108,99,255,.25); color: var(--accent); padding: .2rem .6rem; border-radius: 999px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: .5rem; }
    .media-title { font-size: 1.05rem; font-weight: 700; line-height: 1.3; margin-bottom: .4rem; word-break: break-word; }
    .media-author { color: var(--muted); font-size: .83rem; }
    .media-url { font-family: 'DM Mono', monospace; font-size: .72rem; color: var(--muted); margin-top: .5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Quality cards */
    .section-title { font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; font-size: .78rem; }
    .quality-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .85rem; margin-bottom: 2rem; }
    .quality-card { background: var(--surface); border: 2px solid var(--border); border-radius: 12px; padding: 1.2rem; cursor: pointer; transition: border-color .15s, background .15s; position: relative; }
    .quality-card:hover { border-color: var(--accent); background: rgba(108,99,255,.04); }
    .quality-card.selected { border-color: var(--accent); background: rgba(108,99,255,.08); }
    .quality-card input[type=radio] { position: absolute; opacity: 0; width: 0; height: 0; }
    .quality-badge { display: inline-block; background: rgba(108,99,255,.15); color: var(--accent); padding: .2rem .55rem; border-radius: 6px; font-size: .72rem; font-weight: 700; margin-bottom: .6rem; font-family: 'DM Mono', monospace; }
    .quality-badge.hd { background: rgba(16,185,129,.15); color: var(--success); }
    .quality-badge.audio { background: rgba(245,158,11,.15); color: var(--warning); }
    .quality-ext { font-size: .78rem; color: var(--muted); font-family: 'DM Mono', monospace; margin-bottom: .4rem; }
    .quality-size { font-size: .82rem; color: var(--text); font-weight: 600; }
    .quality-check { position: absolute; top: .75rem; right: .75rem; width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--border); transition: all .15s; display: flex; align-items: center; justify-content: center; font-size: .7rem; }
    .quality-card.selected .quality-check { background: var(--accent); border-color: var(--accent); color: #fff; }

    /* No medias */
    .no-medias { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; text-align: center; color: var(--muted); }

    /* Raw JSON */
    details { margin-bottom: 2rem; }
    summary { cursor: pointer; color: var(--muted); font-size: .82rem; padding: .5rem 0; user-select: none; }
    summary:hover { color: var(--text); }
    pre { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; font-family: 'DM Mono', monospace; font-size: .72rem; overflow-x: auto; color: #a0aec0; max-height: 300px; overflow-y: auto; margin-top: .5rem; }

    /* Save button */
    .save-btn { width: 100%; background: linear-gradient(135deg, var(--accent), #8b5cf6); color: #fff; border: none; border-radius: 12px; padding: 1rem; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; cursor: pointer; transition: opacity .2s; display: flex; align-items: center; justify-content: center; gap: .6rem; }
    .save-btn:hover { opacity: .9; }
    .save-btn:disabled { opacity: .4; cursor: not-allowed; }

    footer { text-align: center; padding: 2rem; color: var(--muted); font-size: .8rem; border-top: 1px solid var(--border); margin-top: 3rem; }

    /* Progress overlay */
    .progress-overlay { display: none; position: fixed; inset: 0; background: rgba(10,10,15,.85); backdrop-filter: blur(8px); z-index: 999; align-items: center; justify-content: center; }
    .progress-overlay.show { display: flex; }
    .progress-box { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 2.5rem; width: 460px; max-width: 90vw; text-align: center; }
    .progress-icon { font-size: 2.5rem; margin-bottom: 1rem; animation: pulse 1.5s ease-in-out infinite; }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .4; } }
    .progress-title { font-size: 1.1rem; font-weight: 700; margin-bottom: .3rem; }
    .progress-sub { font-size: .83rem; color: var(--muted); margin-bottom: 1.5rem; font-family: 'DM Mono', monospace; }
    .progress-bar-wrap { background: var(--bg); border-radius: 999px; height: 10px; overflow: hidden; margin-bottom: .75rem; }
    .progress-bar { height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent2)); border-radius: 999px; width: 0%; transition: width .4s ease; }
    .progress-stats { display: flex; justify-content: space-between; font-size: .78rem; color: var(--muted); font-family: 'DM Mono', monospace; }
    .progress-done { display: none; }
    .progress-done.show { display: block; }
    .done-actions { display: flex; gap: .75rem; margin-top: 1.5rem; }
    .done-btn { flex: 1; padding: .75rem; border-radius: 10px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: .85rem; cursor: pointer; border: none; text-decoration: none; text-align: center; display: flex; align-items: center; justify-content: center; gap: .4rem; }
    .done-btn.primary { background: var(--accent); color: #fff; }
    .done-btn.secondary { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }
    .done-btn.danger { background: rgba(239,68,68,.1); color: #fca5a5; border: 1px solid rgba(239,68,68,.25); }
  </style>
</head>
<body>

<nav class="navbar">
  <a href="/" class="logo">Social<span>DL</span></a>
  <div class="nav-links">
    <a href="/downloader">⬇ Save to Server</a>
    <a href="/downloader/downloads">📂 My Downloads</a>
    <a href="/autolink">🔗 Get Links</a>
    
  </div>
</nav>

<div class="container">
  <a href="/downloader" class="back-link">← Back</a>

  <!-- Media info -->
  <div class="media-card">
    <% if (apiResult.thumbnail) { %>
      <img class="media-thumb" src="<%= apiResult.thumbnail %>" alt="thumb" onerror="this.style.display='none'"/>
    <% } else { %>
      <div class="media-thumb-placeholder">
        <%= platform === 'TikTok' ? '🎵' : platform === 'Instagram' ? '📸' : platform === 'YouTube' ? '▶️' : platform === 'Twitter/X' ? '🐦' : '📘' %>
      </div>
    <% } %>
    <div class="media-info">
      <span class="media-platform"><%= platform %></span>
      <div class="media-title"><%= apiResult.title || 'Untitled Video' %></div>
      <% if (apiResult.author) { %><div class="media-author">@<%= apiResult.author %></div><% } %>
      <div class="media-url"><%= originalUrl %></div>
    </div>
  </div>

  <!-- Quality selection -->
  <% if (apiResult.medias && apiResult.medias.length > 0) { %>
    <div class="section-title">Select Quality to Save</div>
    <div class="quality-grid" id="qualityGrid">
      <% apiResult.medias.forEach((media, i) => {
        const isHD = media.quality && (media.quality.includes('HD') || media.quality.includes('1080') || media.quality.includes('720'));
        const isAudio = media.extension === 'mp3' || media.extension === 'm4a' || (media.quality && media.quality.toLowerCase().includes('audio'));
      %>
      <label class="quality-card <%= i === 0 ? 'selected' : '' %>" onclick="selectCard(this)">
        <input type="radio" name="quality" value="<%= i %>" <%= i === 0 ? 'checked' : '' %>
          data-url="<%= media.url %>"
          data-quality="<%= media.quality || ('Option ' + (i+1)) %>"
          data-ext="<%= media.extension || 'mp4' %>"
          data-size="<%= media.size || '' %>"
        />
        <div class="quality-check"><%= i === 0 ? '✓' : '' %></div>
        <div class="quality-badge <%= isHD ? 'hd' : isAudio ? 'audio' : '' %>">
          <%= media.quality || ('Option ' + (i+1)) %>
        </div>
        <div class="quality-ext">.<%= media.extension || 'mp4' %></div>
        <div class="quality-size"><%= media.size || 'Size unknown' %></div>
      </label>
      <% }) %>
    </div>

    <button class="save-btn" id="saveBtn" onclick="startDownload()">
      <span>⬇</span> Save to Server
    </button>

  <% } else { %>
    <div class="no-medias">
      <p style="font-size:1.5rem;margin-bottom:.5rem">😕</p>
      <p>No downloadable media found for this URL.</p>
      <p style="margin-top:.5rem;font-size:.85rem">The content may be private or unsupported.</p>
    </div>
  <% } %>

  <!-- Raw JSON -->
  <details style="margin-top:1.5rem">
    <summary>🔍 View Raw API Response</summary>
    <pre><%= JSON.stringify(apiResult, null, 2) %></pre>
  </details>
</div>

<!-- Progress Overlay -->
<div class="progress-overlay" id="progressOverlay">
  <div class="progress-box">
    <div id="downloadingView">
      <div class="progress-icon">⬇️</div>
      <div class="progress-title">Saving to Server…</div>
      <div class="progress-sub" id="progSub">Connecting…</div>
      <div class="progress-bar-wrap">
        <div class="progress-bar" id="progBar"></div>
      </div>
      <div class="progress-stats">
        <span id="progDL">0 B</span>
        <span id="progPct">0%</span>
        <span id="progTotal">—</span>
      </div>
    </div>

    <div class="progress-done" id="doneView">
      <div style="font-size:2.5rem;margin-bottom:.75rem">✅</div>
      <div class="progress-title">Saved Successfully!</div>
      <div class="progress-sub" id="doneSub"></div>
      <div class="done-actions">
        <a class="done-btn primary" id="streamBtn" href="#" target="_blank">▶ Stream</a>
        <a class="done-btn secondary" id="dlBtn" href="#" target="_blank">⬇ Download</a>
        <a class="done-btn secondary" href="/downloader/downloads">📂 All Files</a>
      </div>
    </div>

    <div class="progress-done" id="errorView">
      <div style="font-size:2.5rem;margin-bottom:.75rem">❌</div>
      <div class="progress-title">Download Failed</div>
      <div class="progress-sub" id="errMsg"></div>
      <div class="done-actions">
        <button class="done-btn secondary" onclick="closeOverlay()">Try Again</button>
        <a class="done-btn secondary" href="/downloader">New URL</a>
      </div>
    </div>
  </div>
</div>
 <video id="player" controls width="600"></video>
<footer>SocialDL · Server-side Video Downloader · Powered by RapidAPI</footer>

<script>
  function selectCard(label) {
    document.querySelectorAll('.quality-card').forEach(c => {
      c.classList.remove('selected');
      c.querySelector('.quality-check').textContent = '';
    });
    label.classList.add('selected');
    label.querySelector('.quality-check').textContent = '✓';
    label.querySelector('input[type=radio]').checked = true;
  }

  function getSelected() {
    const radio = document.querySelector('input[type=radio]:checked');
    if (!radio) return null;
    return {
      mediaUrl: radio.dataset.url,
      quality: radio.dataset.quality,
      ext: radio.dataset.ext,
    };
  }

  async function startDownload() {
    const sel = getSelected();
    if (!sel) return alert('Please select a quality option.');

    const saveBtn = document.getElementById('saveBtn');
    saveBtn.disabled = true;

    document.getElementById('progressOverlay').classList.add('show');
    document.getElementById('downloadingView').style.display = 'block';
    document.getElementById('doneView').classList.remove('show');
    document.getElementById('errorView').classList.remove('show');
    

    // SSE progress
    const evtSource = new EventSource(`/downloader/progress/${jobId}`);

    evtSource.onmessage = (e) => {
      const d = JSON.parse(e.data);

      if (d.status === 'error') {
        evtSource.close();
        showError(d.error || 'Unknown error');
        saveBtn.disabled = false;
        return;
      }

      document.getElementById('progDL').textContent = d.downloaded || '…';
      document.getElementById('progTotal').textContent = d.total || '…';
      document.getElementById('progPct').textContent = d.percent + '%';
      document.getElementById('progBar').style.width = d.percent + '%';
      document.getElementById('progSub').textContent = d.percent > 0 ? `${d.downloaded} / ${d.total}` : 'Connecting to media server…';

      if (d.status === 'done') {
        evtSource.close();
        showDone(d.fileName);
        saveBtn.disabled = false;
      }
    };

    evtSource.onerror = () => {
      evtSource.close();
      showError('Connection lost. Check the downloads page.');
      saveBtn.disabled = false;
    };
  }

  function showDone(fileName) {
    document.getElementById('downloadingView').style.display = 'none';
    document.getElementById('doneView').classList.add('show');
    document.getElementById('doneSub').textContent = fileName;
    document.getElementById('streamBtn').href = `/downloader/serve/${encodeURIComponent(fileName)}`;
    document.getElementById('dlBtn').href = `/downloader/dl/${encodeURIComponent(fileName)}`;
  }

  function showError(msg) {
    document.getElementById('downloadingView').style.display = 'none';
    document.getElementById('errorView').classList.add('show');
    document.getElementById('errMsg').textContent = msg;
  }

  function closeOverlay() {
    document.getElementById('progressOverlay').classList.remove('show');
    document.getElementById('downloadingView').style.display = 'block';
    document.getElementById('doneView').classList.remove('show');
    document.getElementById('errorView').classList.remove('show');
  }
</script>
</body>
</html>
