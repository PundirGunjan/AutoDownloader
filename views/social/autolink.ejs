<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Universal Downloader — SocialDL</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css" />
</head>

<body>
  <%- include('../partials/nav') %>

    <section class="page-header" style="--accent:#a855f7">
      <div class="page-icon">🔗</div>
      <h1>Universal Downloader</h1>
      <p>Paste any social media URL — TikTok, Instagram, YouTube, Twitter, Facebook</p>
    </section>

    <section class="downloader-section">
      <form class="download-form" action="/autolink" method="POST">
        <div class="form-group">
          <label>Video / Reel / Post URL</label>
          <input type="url" name="url" value="<%= url %>" placeholder="https://www.tiktok.com/@user/video/..."
            required />
        </div>
        <button type="submit" class="submit-btn">
          <span>Fetch Media</span> ↗
        </button>
      </form>

      <% if (result && result.contents && result.contents.length> 0) { %>

        <% const video=result.contents[0].videos[0]; %>

          <% if (video && video.url) { %>
            <video controls width="500">
              <source src="<%= video.url %>" type="video/mp4">
            </video>
            <% } else { %>
              <p>No playable video found</p>
              <% } %>

                <% } %>

                  <div class="example-urls">
                    <p>Try these example URLs:</p>
                    <code>https://www.tiktok.com/@user/video/123…</code>
                    <code>https://www.instagram.com/reel/abc…</code>
                    <code>https://twitter.com/user/status/123…</code>
                  </div>

                  <%- include('../partials/result') %>
    </section>

    <%- include('../partials/footer') %>
</body>

</html>