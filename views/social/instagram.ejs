<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Instagram Downloader — SocialDL</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css" />
</head>

<body>
  <%- include('../partials/nav') %>

    <section class="page-header" style="--accent:#e1306c">
      <div class="page-icon">📸</div>
      <h1>Instagram Downloader</h1>
      <p>Download Reels, Posts, Stories and IGTV videos</p>
    </section>

    <section class="downloader-section">
      <form class="download-form" action="/instagram" method="POST">
        <div class="form-group">
          <label>Instagram URL</label>
          <input type="url" name="url" value="<%= url %>" placeholder="https://www.instagram.com/reel/ABC123…"
            required />
        </div>
        <button type="submit" class="submit-btn" style="--btn-color:#e1306c">
          <span>Download Media</span> ↗
        </button>
      </form>
      <% if (result && result.contents && result.contents.length> 0) { %>

        <% const video=result.contents[0].videos[0]; %>

          <% if (video && video.url) { %>
            <video controls width="500">
              <source src="<%= video.url %>" type="video/mp4">
            </video>
            <% } else { %>
              <p>No playable video found</p>
              <% } %>

                <% } %>

                  <div class="tips-box">
                    <h4>💡 Supported Instagram URLs</h4>
                    <ul>
                      <li>Reels: instagram.com/reel/…</li>
                      <li>Posts: instagram.com/p/…</li>
                      <li>Stories (public accounts only)</li>
                    </ul>
                  </div>

                  <%- include('../partials/result') %>
    </section>

    <%- include('../partials/footer') %>
</body>

</html>